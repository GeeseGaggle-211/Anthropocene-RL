<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>9</LangVersion>
    <AnthropoceneSimRoot Condition="'$(AnthropoceneSimRoot)' == ''">$(MSBuildProjectDirectory)/../../Anthropocene</AnthropoceneSimRoot>
    <SimulationSource>$(AnthropoceneSimRoot)/Assets/_Anthropocene/Simulation</SimulationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SimulationSource)/*.cs" />
    <Compile Include="SnapshotBankContracts.cs" />
    <Compile Include="SnapshotScenarioFactory.cs" />
    <Compile Include="SnapshotBankProgram.cs" />
  </ItemGroup>
</Project>
